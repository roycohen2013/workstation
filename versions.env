# Versions of the tools CI installs. Plain KEY=VALUE so anything can read it:
# the workflows filter it into $GITHUB_ENV, scripts/doctor.sh reads it with sed.
# (Filtered, not cat'd -- a comment line here containing an "=" would otherwise
# be ingested as a bogus variable.)
#
# These are CI's own toolchain, deliberately separate from what the image
# installs. Two other pins live where they belong rather than here, because
# duplicating them would be the exact problem this file exists to solve:
#
#   Ubuntu release      packer/variables.pkr.hcl  (var.ubuntu_release)
#   terraform-docs      ansible/group_vars/all.yml (dev_terraform_docs_*)
#
# Keep these matching what a workstation actually has. The hashicorp repo in
# group_vars installs packer and terraform UNPINNED, so every machine built
# from this repo runs the current release -- CI pinned well below that is
# testing a combination nobody runs. `make doctor` compares the two and warns
# on a mismatch, which is the signal to bump here.
PACKER_VERSION=1.16.0
TERRAFORM_VERSION=1.16.0
